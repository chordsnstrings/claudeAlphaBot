# ===== SAFETY DEFAULTS =====
# PAPER=true: NO real orders sent — only simulates. Set to false ONLY after a paper run.
PAPER=true
# DRY_RUN=true: prints orders but doesn't send. Independent of PAPER.
DRY_RUN=true

# ===== EXCHANGE =====
# Binance USDM Futures recommended. Other ccxt-supported futures exchanges also work.
EXCHANGE=binanceusdm

# Required ONLY when going live (PAPER=false). For testnet, use Binance testnet keys.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Use Binance testnet for safe live testing before real money.
USE_TESTNET=true

# ===== STRATEGY =====
ASSET=ETH                  # ETH or BTC (one at a time for this bot)
BASE_USD=10000             # trading wallet base capital
VOL_TARGET=0.30            # 30% annual vol per sleeve
LEV_CAP=1.5                # leverage cap per sleeve
W_REGIME=0.25
W_POOL=0.75
LEVERAGE_MULT=1.0          # 1.0 = deployed default. 2.0 = 2x aggressive. 3.0 = high risk.
HARVEST_DECAY=0.15         # reset to BASE when equity falls 15% from peak
MAX_LEV_EXCHANGE=10        # exchange-side leverage setting

# ===== EXECUTION =====
LOOP_INTERVAL_SEC=300      # check every 5 min (1h bars close hourly)
REBAL_BAND=0.05            # only rebalance if position drift > 5% of equity
