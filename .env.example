# Trading System v3 — environment variables
#
# All values are validated by Zod at startup (see packages/core/src/config.ts).
# Mode-conditional: backtest fields are required when MODE=backtest,
# live fields are required when MODE=live.

# ---- Universal ----
NODE_ENV=development                # development | test | production
LOG_LEVEL=info                      # trace | debug | info | warn | error
MODE=backtest                       # backtest | live

# Postgres + TimescaleDB. The full URL is the source of truth; individual
# parts are not parsed separately. Format:
#   postgres://USER:PASS@HOST:PORT/DB?option=value
DATABASE_URL=postgres://trading:trading@localhost:5432/trading_dev
DATABASE_POOL_SIZE=10

# ---- Backtest mode ----
BACKTEST_START_DATE=2020-01-01
BACKTEST_END_DATE=2026-05-12
BACKTEST_INITIAL_EQUITY_USD=100000
BACKTEST_FRICTION_PROFILE=pepperstone_razor   # see section 6.10
BACKTEST_RANDOM_SEED=42

# ---- Live mode ----
# cTrader application credentials. Created at id.ctrader.com in Phase 18 using
# the deployed callback endpoint. NOT required for backtest mode.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCOUNT_ID=                 # e.g. 5286746 for demo
CTRADER_ACCOUNT_TYPE=demo           # demo | live

# Populated by the OAuth flow (Phase 18); persisted to whatever secret store
# the host platform provides. Read but not edited by the bot otherwise.
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=

# OAuth callback endpoint. Must match the redirect URL registered with the
# cTrader application. In production this is e.g. https://bot.example.com.
CTRADER_REDIRECT_URL=http://localhost:3000/oauth/callback

# ---- HTTP server (Phase 17+) ----
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# ---- Web UI (Phase 20+) ----
WEB_BASE_URL=http://localhost:3001
