# ──────────────────────────────────────────────────────────────
# Hydra Trading Bot — environment template
# Copy to .env and fill in values. Never commit .env.
# ──────────────────────────────────────────────────────────────

# Runtime mode: backtest | paper | live
BOT_MODE=backtest

# Starting simulated equity (USD). Used in backtest + paper modes.
STARTING_EQUITY_USD=5000

# Postgres connection string
DATABASE_URL=postgresql://hydra:hydra@localhost:5432/hydra

# Fastify health + internal API port (bot side)
BOT_HTTP_PORT=8080

# Logger: debug | info | warn | error
LOG_LEVEL=info
# pretty | json (auto: pretty for non-prod, json for production)
LOG_FORMAT=auto

# Node env
NODE_ENV=development

# ── Binance (required for paper and live only) ────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true = Binance Futures testnet; false = production
BINANCE_TESTNET=true

# ── Validation artifact ───────────────────────────────────────
# Absolute path to validated_config.json. Required for paper/live.
ARTIFACT_PATH=/app/artifacts/validated_config.json

# ── UI-only ──────────────────────────────────────────────────
# Where the UI reaches the bot's internal API (same VPC / docker network)
BOT_INTERNAL_API_URL=http://bot:8080
