{
  "name": "trading-system",
  "private": true,
  "version": "0.1.0",
  "description": "Systematic trading system with backtest + live (cTrader/Pepperstone) modes. See trading_system_docs.md.",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "lint": "eslint --max-warnings=0 \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/test/**/*.{ts,tsx}\"",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,json,md}\"",
    "dev": "echo \"dev: phase-specific entrypoints come online from Phase 5+\"",
    "clean": "pnpm -r exec rm -rf dist .turbo .vitest-cache *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@typescript-eslint/eslint-plugin": "7.16.1",
    "@typescript-eslint/parser": "7.16.1",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  }
}
