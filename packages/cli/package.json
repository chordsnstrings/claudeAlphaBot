{
  "name": "@trading/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "trading-cli": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "backtest": "tsx src/bin.ts backtest",
    "ingest:full": "tsx src/bin.ts ingest:full",
    "ingest:asset": "tsx src/bin.ts ingest:asset",
    "ingest:incremental": "tsx src/bin.ts ingest:incremental",
    "ingest:report": "tsx src/bin.ts ingest:report"
  },
  "dependencies": {
    "@trading/adapters": "workspace:*",
    "@trading/core": "workspace:*",
    "@trading/data": "workspace:*",
    "@trading/engine": "workspace:*",
    "@trading/metrics": "workspace:*",
    "@trading/risk": "workspace:*",
    "@trading/strategies": "workspace:*",
    "commander": "12.1.0"
  },
  "devDependencies": {
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  }
}
