{
  "name": "@hydra/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "migrate:up": "tsx src/cli/migrate.ts up",
    "migrate:down": "tsx src/cli/migrate.ts down",
    "backfill": "tsx src/cli/backfill.ts",
    "validate-pipeline": "tsx src/cli/run-validation.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hydra/shared": "workspace:*",
    "date-fns": "3.3.1",
    "date-fns-tz": "2.0.0",
    "decimal.js": "10.4.3",
    "dotenv": "16.4.5",
    "fastify": "4.26.2",
    "@fastify/rate-limit": "9.1.0",
    "node-cron": "3.0.3",
    "p-retry": "6.2.0",
    "pg": "8.11.3",
    "pino": "8.19.0",
    "pino-pretty": "10.3.1",
    "undici": "6.13.0",
    "ws": "8.16.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/node": "20.11.25",
    "@types/node-cron": "3.0.11",
    "@types/pg": "8.11.2",
    "@types/ws": "8.5.10",
    "tsx": "4.7.1",
    "typescript": "5.3.3",
    "vitest": "1.3.1",
    "@vitest/coverage-v8": "1.3.1"
  }
}
