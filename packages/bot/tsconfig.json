{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "types": ["node"],
    "paths": {
      "@hydra/shared": ["../shared/src/index.ts"],
      "@hydra/shared/*": ["../shared/src/*"]
    },
    "baseUrl": "."
  },
  "references": [{ "path": "../shared" }],
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "tests", "src/**/*.test.ts"]
}
