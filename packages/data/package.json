{
  "name": "@trading/data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./repos": {
      "types": "./dist/repos/index.d.ts",
      "default": "./dist/repos/index.js"
    },
    "./ingestion": {
      "types": "./dist/ingestion/index.d.ts",
      "default": "./dist/ingestion/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate-cli.ts"
  },
  "files": ["dist", "migrations"],
  "dependencies": {
    "@trading/core": "workspace:*",
    "drizzle-orm": "0.32.0",
    "dukascopy-node": "1.46.4",
    "pg": "8.12.0"
  },
  "devDependencies": {
    "@types/pg": "8.11.6",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vitest": "1.6.0"
  }
}
